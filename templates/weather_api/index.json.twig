{
  "city": "{{ city|e('js') }}",
  "country": "{{ country|e('js') }}",
  "measurements": [
{% for m in measurements %}
    {
      "date": "{{ m.date|date('Y-m-d')|raw }}",
      "celsius": {{ m.temperature }},
      "fahrenheit": {{ m.getTemperatureInFahrenheit() }},
      "precipitation": {{ m.precipitation }},
      "humidity": {{ m.humidity }},
      "wind": {{ m.wind }}
    }{% if not loop.last %},{% endif %}{{ "" }}
{% endfor %}
  ]
}
